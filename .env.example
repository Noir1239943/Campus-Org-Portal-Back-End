APP_NAME="CPC Campus Organizations"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

# Where the React app runs. Comma-separate several origins if needed.
FRONTEND_URL=http://localhost:5173
# Optional: allow Vercel preview URLs, e.g. #^https://cpc-orgs-.*\.vercel\.app$#
CORS_ALLOWED_PATTERN=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local development uses a SQLite file (database/database.sqlite) — no setup needed.
DB_CONNECTION=sqlite

# Production (Neon Postgres) — set these on Render instead:
# DB_CONNECTION=pgsql
# DB_URL=postgresql://USER:PASSWORD@ep-xxxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DB_SSLMODE=require

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12

# Login tokens last 7 days (in minutes). "Keep me signed in" makes it 30 days.
SANCTUM_EXPIRATION=10080

# ---- School & term settings ----
SCHOOL_NAME="Cordova Public College"
SCHOOL_SHORT=CPC
SCHOOL_LOCATION="Cordova, Cebu"
OSA_EMAIL=osa@cpc.edu.ph
ACADEMIC_YEAR="2026–2027"
SEMESTER="1st Semester"
SEMESTER_MONTHS=8,9,10,11,12
SERVICE_HOURS_GOAL=20
ATTENDANCE_THRESHOLD=75
MEMBER_RISK_THRESHOLD=70
LATE_AFTER_MINUTES=15
CHECK_IN_CODE_SECONDS=60
EXCUSE_WINDOW_DAYS=7
REQUIRE_EVENT_APPROVAL=true
